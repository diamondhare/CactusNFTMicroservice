{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api-service",
  "sourceRoot": "apps/api-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api-service/tsconfig.app.json"
  },
  "projects": {
    "api-service": {
      "type": "application",
      "root": "apps/api-service",
      "entryFile": "main",
      "sourceRoot": "apps/api-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-service/tsconfig.app.json"
      }
    },
    "blockchain": {
      "type": "library",
      "root": "libs/blockchain",
      "entryFile": "index",
      "sourceRoot": "libs/blockchain/src",
      "compilerOptions": {
        "tsConfigPath": "libs/blockchain/tsconfig.lib.json"
      }
    },
    "bots-service": {
      "type": "application",
      "root": "apps/bots-service",
      "entryFile": "main",
      "sourceRoot": "apps/bots-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/bots-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "events-service": {
      "type": "application",
      "root": "apps/events-service",
      "entryFile": "main",
      "sourceRoot": "apps/events-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/events-service/tsconfig.app.json"
      }
    },
    "game-master": {
      "type": "application",
      "root": "apps/game-master",
      "entryFile": "main",
      "sourceRoot": "apps/game-master/src",
      "compilerOptions": {
        "tsConfigPath": "apps/game-master/tsconfig.app.json"
      }
    }
  }
}