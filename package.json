{
  "name": "cactus-nftmicroservices",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:api": "nest build api-service",
    "build:events": "nest build events-service",
    "build:bots": "nest build bots-service",
    "build:game-master": "nest build game-master",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start api-service",
    "start:dev": "nest start api-service --watch",
    "start:dev:api": "nest start api-service --watch",
    "start:dev:events": "nest start events-service --watch",
    "start:dev:bots": "nest start bots-service --watch",
    "start:debug": "nest start api-service --debug --watch",
    "start:dev:game-master": "nest start game-master --watch",
    "start:prod": "node dist/apps/api-service/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "docker:up": "docker compose up -d postgres hardhat-node redis",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "db:migration:run": "typeorm-ts-node-commonjs -d libs/database/src/typeorm.data-source.ts migration:run",
    "db:migration:revert": "typeorm-ts-node-commonjs -d libs/database/src/typeorm.data-source.ts migration:revert",
    "contracts:sync-abis": "node scripts/sync-contract-abis.mjs",
    "admin:sign": "ts-node -r tsconfig-paths/register scripts/sign-admin-action.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.27",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ethers": "^6.16.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@app/common$": "<rootDir>/libs/common/src",
      "^@app/common/(.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/database$": "<rootDir>/libs/database/src",
      "^@app/database/(.*)$": "<rootDir>/libs/database/src/$1",
      "^@app/queue$": "<rootDir>/libs/queue/src",
      "^@app/queue/(.*)$": "<rootDir>/libs/queue/src/$1",
      "^@app/blockchain$": "<rootDir>/libs/blockchain/src",
      "^@app/blockchain/abis/(.*)$": "<rootDir>/libs/blockchain/src/abis/$1",
      "^@app/blockchain/(.*)$": "<rootDir>/libs/blockchain/src/$1"
    },
    "collectCoverageFrom": [
      "apps/**/*.(t|j)s",
      "libs/**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}
